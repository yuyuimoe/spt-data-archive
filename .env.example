# Copy to .env and fill in. Use alphanumeric passwords (the reader password is interpolated into SQL).
ARCHIVE_OWNER_PASSWORD=
ARCHIVE_READER_PASSWORD=

# Absolute path of the server's SPT_Data folder on this machine (after "git lfs pull"). Mounted read-only.
SPT_DATA_PATH=

# Optional: host port for the API.
API_PORT=8080
