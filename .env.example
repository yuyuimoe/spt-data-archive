# The environment of this archive: one file, read by everything, written by nothing (ADR-0030).
# Copy to .env and fill in. ".env" is ignored by Git; this file is the contract.
# Use alphanumeric passwords (the reader password is interpolated into SQL).
#
# What belongs here: facts of the machine and of the installation. What does not: a choice of
# one run (a mod name, a curated reason, a force). Those are arguments of the runner, because a
# value that changes per run would make this file a log that two runs race on.

# ---- PostgreSQL -------------------------------------------------------------------------------
ARCHIVE_OWNER_PASSWORD=
ARCHIVE_READER_PASSWORD=

# ---- The server installation ------------------------------------------------------------------
# Absolute path of the server's SPT_Data folder on this machine (after "git lfs pull").
# Mounted read-only: the archive never writes to an installation.
SPT_DATA_PATH=

# The release that the installation above is. The files do not state it (TD-26).
SPT_RELEASE=4.1.6

# ---- The mod runner (ADR-0013, ADR-0030) ------------------------------------------------------
# The container image of SPT_RELEASE. Its tag must end in SPT_RELEASE; a mismatch fails before a
# container starts. One image per release: a build for 4.1.6 is refused by a 4.1.5 container.
SPT_IMAGE=localhost/spt-server:4.1.6

# Where the unpacked mods live: one directory per mod, its name is the directory name.
ARCHIVE_MODS_DIR=/home/yui/work/sptmods/all

# Where each run's export lands: one directory per run.
ARCHIVE_EXPORTS_DIR=/home/yui/work/sptmods/exports

# Where the baselines live: one per release, named by release. A mod run is compared with the
# baseline of its own release (ADR-0013, ADR-0029).
ARCHIVE_BASELINES_DIR=/home/yui/work/sptmods/exports

# ---- The API ----------------------------------------------------------------------------------
# Host port of the read-only API.
API_PORT=8080
# The Redis response cache (ADR-0008, ADR-0037). An empty ConnectionStrings__Redis means an
# in-process memory cache, which every Api instance keeps for itself.
ConnectionStrings__Redis=redis:6379
# How long an answer lives, in seconds, and how much that life is spread (percent). The spread
# stops answers that were stored together from expiring together.
Cache__TtlSeconds=60
Cache__TtlJitterPercent=10
# How long a request sent with an Idempotency-Key can be replayed.
Cache__IdempotencySeconds=300
# The most requests that may wait for one query at the same time. 0 switches the collapsing off.
Cache__MaxFlights=1024
# How long the Api stops trying a cache that failed.
Cache__DownSeconds=30
# An answer larger than this is answered but not stored, which bounds the memory the cache holds.
Cache__MaxResponseBytes=2097152

# ---- Api edge guard (ADR-0038) ----------------------------------------------------------------
# One token bucket per client address: a burst of TokenLimit, refilled at TokensPerPeriod per
# ReplenishSeconds. The defaults allow 10 requests per second per address. Only /graphql is charged.
RateLimit__Enabled=true
RateLimit__TokenLimit=100
RateLimit__TokensPerPeriod=100
RateLimit__ReplenishSeconds=10
# The most client buckets the Api keeps, and how long it keeps an unused one.
RateLimit__MaxClients=50000
RateLimit__IdleMinutes=10
# The Api asks Postgres for at most this many connections. Keep it under max_connections of the server.
Database__MaxPoolSize=30

# ---- Backup (ADR-0011, scripts/backup.sh) -----------------------------------------------------
# The script reads the standard PostgreSQL variables. Put the password in PGPASSWORD, in the
# shell or in ~/.pgpass, never in a file in Git. The user needs read access to every table.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=archive_owner
ARCHIVE_DB_NAME=archive
# Where dumps go (local disk), and a second place for the copy off the host (a mounted share).
# An empty copy directory means no copy: ADR-0011 wants one, so set it in production.
ARCHIVE_BACKUP_DIR=./backups
ARCHIVE_BACKUP_COPY_DIR=
# The dump is always compressed. 6 is the floor (ADR-0011): N means gzip level N, and "gzip:N",
# "zstd:N" and "xz:N" name the method. A plain dump of the development archive is 5 times as large.
ARCHIVE_BACKUP_COMPRESSION=6
# Keep the newest N dumps, and the newest dump of each of the last M weeks.
ARCHIVE_BACKUP_KEEP_DAILY=7
ARCHIVE_BACKUP_KEEP_WEEKLY=4
