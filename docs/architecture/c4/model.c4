// C4 model of the SPT Data Archive.
// Source of truth for the structure. Views are in views.c4. Decisions are in docs/adr.

model {

  // ---------------------------------------------------------------- People

  consumer = person 'API Consumer' {
    description 'A mod developer, tool or website that reads item, quest, trader and translation data.'
  }

  maintainer = person 'Maintainer' {
    description 'Starts archive runs, restores backups and administers the archive.'
  }

  // ------------------------------------------------------- External systems

  sptServer = softwareSystem 'SPT Server repository' {
    description 'The server-csharp repository. Its SPT_Data/database folder holds the JSON database. Large files such as items.json use Git LFS.'
  }

  modSources = softwareSystem 'Mod sources' {
    #planned
    description 'The mod releases of the catalog, with their versions, server ranges and dependency sets. The archive installs one mod version per container (ADR-0013).'
  }

  edge = softwareSystem 'Edge proxy' {
    #planned
    description 'Rate limiting and TLS in front of the Api. The Api has no rate limit of its own.'
  }

  // ------------------------------------------------------------ The system

  archive = softwareSystem 'SPT Data Archive' {
    description 'Stores the SPT server data model in PostgreSQL, with official and mod data kept apart, and serves it through a public read-only GraphQL API.'

    api = container 'Api' {
      technology 'ASP.NET Core, HotChocolate'
      description 'Public read-only GraphQL endpoint. It has no mutations.'

      queryCache = component 'Query Cache Middleware' {
        technology 'ASP.NET Core middleware'
        description 'Caches complete GraphQL responses. The key is the request body hash plus the dataset version.'
      }

      graphql = component 'GraphQL Query' {
        technology 'HotChocolate'
        description 'One Query type. Paging, filtering and sorting for official and mod collections. Every official field takes one archived release and answers from the latest when it is left out (ADR-0014, ADR-0019). A request is bounded by size, depth, time and cost.'
      }

      apiDbAccess = component 'ArchiveDbContext (Api)' {
        technology 'EF Core, SptArchive.Core'
        description 'Pooled no-tracking context. It connects with the read-only database role.'
      }
    }

    archiver = container 'Archiver' {
      technology '.NET Worker Service'
      description 'Run-to-completion job. It reads the server JSON, replaces the official tables and exits.'

      archiveJob = component 'Archive Job' {
        technology 'BackgroundService'
        description 'Hashes the source, skips unchanged data, runs importers in one transaction, records the run, announces the dataset. With Archive:RunPath it imports one mod run instead (TD-29).'
      }

      runImport = component 'Run Import' {
        technology 'C#, SptArchive.Archiver.Runs'
        description 'Compares a run directory with the baseline of its release in the canonical form (ADR-0028) and writes the dataset, the observation, the templates, the changed item paths and the mod rows. A change without a mod table is hashed and named, not stored (TD-45).'
      }

      importers = component 'Importers' {
        technology 'IImporter implementations'
        description 'Locale, Item, Quest and Trader importers. Each one reads one part of the JSON database.'
      }

      sourceSupport = component 'Source Support' {
        technology 'C# helpers'
        description 'JSON reading, Git LFS pointer check, source hashing and batched writes.'
      }

      archiverDbAccess = component 'ArchiveDbContext (Archiver)' {
        technology 'EF Core, SptArchive.Core'
        description 'Pooled context. It connects with the owner role, applies migrations and writes data.'
      }
    }

    modRunner = container 'Mod Runner' {
      technology 'Docker, one server container per mod version'
      description 'Starts a throwaway server container for one mod version and its dependencies. No network, one container per run, then a hard stop. It hands the export of the run to the Archiver (ADR-0013).'

      exporterMod = component 'Exporter Mod' {
        technology 'C# server mod, IOnLoad at PostLoad + 1'
        description 'Reads every table, including the lazy loads, and writes the final in-memory database as a directory in the layout of SPT_Data/database, plus run/: the mods that loaded, the manifest of every file with its hash, the text of every configuration file, and every HTTP route with the mod that owns it. Then it stops the host (ADR-0020, ADR-0027, ADR-0029, ADR-0031).'
      }

      bundlePatch = component 'Container start-up cut' {
        technology 'C# server mod, HarmonyX prefix patch'
        description 'Stops the bundle step before it runs, so a run starts in seconds. ADR-0020 replaced the HarmonyX export with a load-order hook; the bundle cut is the remaining patch.'
      }

      baselineCache = component 'Baseline Cache' {
        technology 'C# helper, content addressed'
        description 'Keeps the export of a dependency set without the target mod, so mods with the same dependencies share one baseline.'
      }
    }

    backupScript = container 'Backup Script' {
      technology 'bash, pg_dump, pg_restore'
      description 'Dumps the archive to a custom-format file with a checksum, proves that the file restores, prunes old files and restores into a new database (ADR-0011). A maintainer runs it; nothing schedules it yet (TD-03).'
    }

    db = database 'PostgreSQL' {
      technology 'PostgreSQL 17'
      description 'Official tables and mod tables with identical columns, plus mods, languages and archive runs.'
    }

    redis = cache 'Redis' {
      technology 'Redis 7'
      description 'Response cache and the dataset version key. Bounded memory, no persistence.'
    }
  }

  // ----------------------------------------------- Relationships: context

  consumer -> edge 'Sends GraphQL requests' {
    #planned
  }
  edge -> archive.api 'Forwards requests' {
    #planned
  }
  consumer -> archive.api 'Sends GraphQL requests over HTTPS'
  maintainer -> archive.archiver 'Starts a run (cron, systemd timer or docker compose run)'
  maintainer -> archive.backupScript 'Runs a dump, a verify or a restore'
  archive.backupScript -> archive.db 'Dumps every table and restores into a scratch database'
  archive.archiver -> sptServer 'Reads SPT_Data/database (read-only mount)'
  archive.archiver -> modSources 'Reads the mod versions, their server ranges and their dependency sets' {
    #planned
  }
  archive.archiver -> archive.modRunner 'Starts one run per mod version'
  archive.modRunner -> sptServer 'Runs the server from a pinned commit (read-only mount)'
  archive.modRunner -> archive.db 'Reads the official baseline, writes the dataset and the observation'

  // -------------------------------------------- Relationships: containers

  archive.api -> archive.db 'Reads with the read-only role'
  archive.api -> archive.redis 'Reads and stores cached responses'
  archive.archiver -> archive.db 'Replaces official tables in one transaction with the owner role'
  archive.archiver -> archive.redis 'Publishes the new dataset version'

  // -------------------------------------------- Relationships: components

  archive.api.queryCache -> archive.api.graphql 'Passes cache misses'
  archive.api.queryCache -> archive.redis 'Reads the dataset version, reads and stores responses'
  archive.api.graphql -> archive.api.apiDbAccess 'Builds queries'
  archive.api.apiDbAccess -> archive.db 'Runs SELECT queries'

  archive.archiver.archiveJob -> archive.archiver.sourceSupport 'Hashes the source files'
  archive.archiver.archiveJob -> archive.archiver.importers 'Runs in registration order'
  archive.archiver.archiveJob -> archive.archiver.archiverDbAccess 'Migrates, records runs, owns the transaction'
  archive.archiver.archiveJob -> archive.redis 'Publishes the dataset version'
  archive.archiver.importers -> archive.archiver.sourceSupport 'Reads JSON, queues rows'
  archive.archiver.importers -> archive.archiver.archiverDbAccess 'Writes rows in batches'
  archive.archiver.sourceSupport -> sptServer 'Reads files'
  archive.archiver.archiverDbAccess -> archive.db 'Runs DDL and DML'

  archive.modRunner.exporterMod -> archive.modRunner.baselineCache 'Gives the export of the target run'
  archive.modRunner.bundlePatch -> archive.modRunner.exporterMod 'Keeps the start-up short enough to run 699 times'
  archive.modRunner.baselineCache -> archive.db 'Compares the export with the stored content hash'
}
