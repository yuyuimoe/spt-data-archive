// Deployment of the containers. Matches compose.yaml.
// Postgres, Redis and the Api are not published to the host. Only the proxy publishes a port.

deployment {

  environment prod 'Docker Compose stack' {

    host dockerHost 'Docker host' {
      description 'One machine that runs compose.yaml.'

      instanceOf archive.caddy
      instanceOf archive.db
      instanceOf archive.redis
      instanceOf archive.api
      instanceOf archive.archiver
      instanceOf archive.modRunner
    }
  }
}
