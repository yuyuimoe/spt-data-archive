<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core = entities + EF Core DbContext + migrations. No business logic, no web, no hosting.
    Both the Archiver (writer) and the Api (reader) depend on it.
    Package versions are pinned once, in Directory.Packages.props (TD-07).
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The volatile path list of ADR-0028 is data: a run reads it, a release change edits it. -->
    <EmbeddedResource Include="Canonical\volatile-paths.json" LogicalName="SptArchive.Core.Canonical.volatile-paths.json" />
  </ItemGroup>

</Project>
